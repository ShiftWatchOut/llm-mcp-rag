{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true
  },
  "include": [
    "ai/src/**/*",
    "client/src/**/*",
    "server/src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
